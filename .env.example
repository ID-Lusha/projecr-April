# LLM (DeepSeek по умолчанию; для OpenAI: base_url=https://api.openai.com/v1, model=gpt-4o)
OPENAI_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=ai_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Frontend
# При деплое по IP: http://<IP_СЕРВЕРА>/api
# При деплое с доменом: https://yourdomain.com/api
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api

# Backend
# При деплое по IP: http://<IP_СЕРВЕРА>
# При деплое с доменом: https://yourdomain.com
CORS_ORIGINS=http://YOUR_SERVER_IP

# Telegram (опционально — для уведомлений о лидах)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
